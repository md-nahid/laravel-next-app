# Public: Laravel application origin (scheme + host, optional port). No trailing slash.
# Used by Axios in src/_api/factory.ts for all API requests.
NEXT_PUBLIC_REST_API_ENDPOINT=http://localhost:8000/api
NEXT_PUBLIC_REVERB_APP_KEY=local
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
